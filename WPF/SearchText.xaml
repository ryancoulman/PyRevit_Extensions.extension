<Window x:Class="WPFpreview.SearchText"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Search Text"
        Width="270"
        ResizeMode="NoResize"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        MinHeight="250">

    <!-- Global Resources -->
    <Window.Resources>
        <!-- Global font size -->
        <sys:Double x:Key="GlobalFontSize">13</sys:Double>
        <Thickness x:Key="StandardMargin">0,5</Thickness>
        <Thickness x:Key="LeftButtonMargin">0,2,2,2</Thickness>
        <Thickness x:Key="RightButtonMargin">2,2,0,2</Thickness>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Styles -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="2"/>
            <Setter Property="FontSize" Value="{StaticResource GlobalFontSize}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="MinHeight" Value="60"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="{StaticResource GlobalFontSize}"/>
        </Style>

        <Style TargetType="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="FontSize" Value="{StaticResource GlobalFontSize}"/>
        </Style>

        <!-- Style for text in square brackets -->
        <Style x:Key="BracketTextStyle" TargetType="Run">
            <Setter Property="FontFamily" Value="Bahnschrift SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>


        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="{StaticResource GlobalFontSize}"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0"/>
            <Setter Property="FontSize" Value="{StaticResource GlobalFontSize}"/>
        </Style>

        <Style TargetType="Expander" x:Key="MinimalExpanderStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <DockPanel>
                            <!-- Header -->
                            <ToggleButton x:Name="HeaderToggleButton"
                                          DockPanel.Dock="Top"
										  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
										  Background="Transparent"
										  BorderBrush="Transparent"
										  Focusable="False"
										  HorizontalAlignment="Left">

                                <!-- Minimal ToggleButton style to remove default highlight etc -->
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <!-- Only show content, no background or border -->
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </ToggleButton.Template>

                                <StackPanel Orientation="Horizontal">
                                    <!-- Chevron -->
                                    <Path x:Name="Arrow"
										  Width="10" Height="10"
										  Margin="0,0,5,0"
										  Stroke="Black"
										  StrokeThickness="2"
										  Data="M 0 7 L 5 0 L 10 7"/>
                                    <!-- Header text -->
                                    <TextBlock x:Name="HeaderText"
											   Text="{TemplateBinding Header}"
											   VerticalAlignment="Center"
											   Opacity="0.5"
                                               ToolTipService.ShowOnDisabled="True"
											   ToolTipService.ShowDuration="60000">
                                        <TextBlock.ToolTip>
                                            <StackPanel x:Name="HeaderToolTip" Margin="5" MaxWidth="300">
                                                <!-- default placeholder content -->
                                            </StackPanel>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                    <!-- default collapsed opacity -->
                                </StackPanel>
                            </ToggleButton>

                            <!-- Expander content -->
                            <ContentPresenter Margin="{StaticResource StandardMargin}"
											  Visibility="{TemplateBinding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </DockPanel>

                        <!-- Chevron flip, hover underline, opacity + header text -->
                        <ControlTemplate.Triggers>
                            <!-- Flip chevron when expanded -->
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" CenterX="5" CenterY="3.5"/>
                                    </Setter.Value>
                                </Setter>

                                <!-- Regex safe mode: full opacity, optional header text -->
                                <Setter TargetName="HeaderText" Property="Opacity" Value="1"/>
                                <Setter Property="Header" Value="Regex Safe Mode"/>

                                <!-- Change tooltip dynamically -->
                                <Setter TargetName="HeaderText" Property="ToolTip">
                                    <Setter.Value>
                                        <ToolTip  MaxWidth="300" ToolTipService.ShowDuration="60000">
                                            <StackPanel Margin="5">
                                                <!-- Title -->
                                                <TextBlock Text="Regex Safe Mode" FontWeight="Bold" FontSize="13" Margin="0,0,0,5"/>
                                                <!-- Introduction -->
                                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
													In this mode, you can type normal text safely. Special symbols will be treated as normal characters unless you put them inside square brackets <Run FontWeight="Bold">[]</Run>.
                                                </TextBlock>
                                                <!-- Using Buttons -->
                                                <TextBlock Text="Using the Buttons:" FontWeight="Bold" Margin="0,5,0,2"/>
                                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
													Click the buttons above to add common search patterns. These are automatically placed inside brackets. For example: <Run FontWeight="Bold">[0-9]</Run> or <Run FontWeight="Bold">[.]</Run>.
                                                </TextBlock>
                                                <!-- Syntax Inside Brackets -->
                                                <TextBlock Text="Syntax Inside Brackets:" FontWeight="Bold" Margin="0,5,0,2"/>
                                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
													Inside brackets, the syntax follows standard regex rules. Only the basic commands are provided as buttons for simplicity, but you can use any regex patterns inside brackets.  
                                                    Note: If you wish to use square brackets literly please escape them with a backslash for saftey, e.g. <Run FontWeight="Bold">[\[]</Run> or <Run FontWeight="Bold">[\]]</Run>.
                                                </TextBlock>
                                                <!-- Groups -->
                                                <TextBlock Text="Groups:" FontWeight="Bold" Margin="0,5,0,2"/>
                                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
													You can create groups by using parentheses inside brackets. Groups let you combine multiple options. For example: <Run FontWeight="Bold">[(apple|orange)]</Run> matches either "apple" or "orange". You can also nest groups: <Run FontWeight="Bold">[(red|green|blue) (apple|banana)]</Run> matches "red apple", "green banana", etc.
                                                </TextBlock>
                                                <!-- Safety Explanation -->
                                                <TextBlock Text="Why it’s Safe:" FontWeight="Bold" Margin="0,5,0,2"/>
                                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,5">
													Any special character you type outside brackets is automatically escaped, so it will match literally. You can use any characters safely — just put advanced ones in brackets if needed.
                                                </TextBlock>
                                                <!-- Advanced Users -->
                                                <TextBlock Text="Advanced (Optional):" FontWeight="Bold" Margin="0,5,0,2"/>
                                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,0" FontStyle="Italic">
													Standard regex commands still work inside brackets. For example, typing <Run FontWeight="Bold">*</Run> outside brackets is treated as a literal *, but inside brackets you can use <Run FontWeight="Bold">[*]</Run> to match zero or more of the preceding element.
                                                </TextBlock>
                                            </StackPanel>
                                        </ToolTip>
                                    </Setter.Value>
                                </Setter>

                            </Trigger>

                            <!-- Collapsed / plain text mode -->
                            <Trigger Property="IsExpanded" Value="False">

                                <!-- Plain text mode: reduced opacity, optional header text -->
                                <Setter TargetName="HeaderText" Property="Opacity" Value="0.8"/>
                                <Setter Property="Header" Value="Plain Text Mode"/>

                                <!-- Change tooltip dynamically -->
                                <Setter TargetName="HeaderText" Property="ToolTip">
                                    <Setter.Value>
                                        <ToolTip>
                                            <StackPanel Margin="5" MaxWidth="250">
                                                <TextBlock Text="Plain Text Mode:" FontWeight="Bold" FontSize="13" Margin="0,0,0,5"/>
                                                <TextBlock TextWrapping="Wrap" Margin="0,2,0,0">
													You are in plain text mode. Type normally, no regex rules apply.
                                                </TextBlock>
                                                <TextBlock TextWrapping="Wrap" Margin="0,5,0,0" FontStyle="Italic">
													Expand to enter ReGeX safe mode.
                                                </TextBlock>
                                            </StackPanel>
                                        </ToolTip>
                                    </Setter.Value>
                                </Setter>

                            </Trigger>

                            <!-- Underline header text on hover -->
                            <Trigger SourceName="HeaderText" Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderText" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="10">
        <StackPanel>
            <!-- Match Row -->
            <Grid Margin="{StaticResource StandardMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label x:Name="MatchLabel" Content="Match Type"/>
                <ComboBox x:Name="MatchComboBox" Grid.Column="2" Width="150" SelectionChanged="MatchComboBox_SelectionChanged"/>
            </Grid>

            <!-- TextBox -->
            <Grid>
                <TextBox x:Name="InputTextBox"
                         TextChanged="InputTextBox_TextChanged"
                         SelectionChanged="InputTextBox_SelectionChanged"
                         GotFocus="InputTextBox_GotFocus"
                         LostFocus="InputTextBox_LostFocus"/>
                <!-- Overlay 'Enter text' hint in textbox -->
                <TextBlock x:Name="InputHint"
                           Text="Enter text"
                           Foreground="Gray"
                           Opacity="0.8"
                           IsHitTestVisible="False"
                           Margin="6,8,0,0"
                           VerticalAlignment="Top"
						   FontSize="{StaticResource GlobalFontSize}"
                           FontStyle="Italic"
                           Visibility="Visible"/>
            </Grid>

            <!-- Regex Shortcut Buttons -->
            <Expander x:Name="ReSafeExpander" IsExpanded="True" Expanded="ReSafeExpander_Expanded" Collapsed="ReSafeExpander_Collapsed" Margin="{StaticResource StandardMargin}" Style="{StaticResource MinimalExpanderStyle}">

                <UniformGrid Columns="2" HorizontalAlignment="Stretch">
                    <Button x:Name="BtnLetter" Tag="[[a-zA-Z]]" Margin="{StaticResource LeftButtonMargin}" Click="ReShortcutButton_Click">
                        <Button.Content>
                            <TextBlock>
                                Any Letter
                                <Run Style="{StaticResource BracketTextStyle}"> [a-zA-Z]</Run>
                            </TextBlock>
                        </Button.Content>
                    </Button>
                    <Button x:Name="BtnNum" Tag="[\d]" Margin="{StaticResource RightButtonMargin}" Click="ReShortcutButton_Click">
                        <Button.Content>
                            <TextBlock>
                                Any Num
                                <Run Style="{StaticResource BracketTextStyle}"> [\d]</Run>
                            </TextBlock>
                        </Button.Content>
                    </Button>
                    <Button x:Name="BtnChar" Tag="[.]" Margin="{StaticResource LeftButtonMargin}" Click="ReShortcutButton_Click">
                        <Button.Content>
                            <TextBlock>
                                Any Char
                                <Run Style="{StaticResource BracketTextStyle}"> [.]</Run>
                            </TextBlock>
                        </Button.Content>
                    </Button>
                    <Button x:Name="BtnWhitespace" Tag="[\s]" Margin="{StaticResource RightButtonMargin}" Click="ReShortcutButton_Click">
                        <Button.Content>
                            <TextBlock>
                                Whitespace
                                <Run Style="{StaticResource BracketTextStyle}"> [\s]</Run>
                            </TextBlock>
                        </Button.Content>
                    </Button>
                    <Button x:Name="BtnZeroOrMore" Tag="[*]" Margin="{StaticResource LeftButtonMargin}" Click="ReShortcutButton_Click">
                        <Button.Content>
                            <TextBlock>
                                Zero or More
                                <Run Style="{StaticResource BracketTextStyle}"> [*]</Run>
                            </TextBlock>
                        </Button.Content>
                    </Button>
                    <Button x:Name="BtnOneOrMore" Tag="[+]" Margin="{StaticResource RightButtonMargin}" Click="ReShortcutButton_Click">
                        <Button.Content>
                            <TextBlock>
                                One or More
                                <Run Style="{StaticResource BracketTextStyle}"> [+]</Run>
                            </TextBlock>
                        </Button.Content>
                    </Button>
                    <Button x:Name="BtnExactlyN" Tag="{}[{N}]" Margin="{StaticResource LeftButtonMargin}" Click="ReShortcutButton_Click">
                        <Button.Content>
                            <TextBlock>
                                Exactly N
                                <Run Style="{StaticResource BracketTextStyle}"> [{N}]</Run>
                            </TextBlock>
                        </Button.Content>
                    </Button>
                    <Button x:Name="BtnRangeN" Tag="{}[{N,M}]" Margin="{StaticResource RightButtonMargin}" Click="ReShortcutButton_Click">
                        <Button.Content>
                            <TextBlock>
                                Range N-M
                                <Run Style="{StaticResource BracketTextStyle}"> [{N,M}]</Run>
                            </TextBlock>
                        </Button.Content>
                    </Button>
                    <Button x:Name="BtnOptional" Tag="[?]" Margin="{StaticResource LeftButtonMargin}" Click="ReShortcutButton_Click">
                        <Button.Content>
                            <TextBlock>
                                Optional
                                <Run Style="{StaticResource BracketTextStyle}"> [?]</Run>
                            </TextBlock>
                        </Button.Content>
                    </Button>
                    <Button x:Name="BtnSet" Tag="[[abc]]" Margin="{StaticResource RightButtonMargin}" Click="ReShortcutButton_Click">
                        <Button.Content>
                            <TextBlock>
                                Set
                                <Run Style="{StaticResource BracketTextStyle}"> [[abc]]</Run>
                            </TextBlock>
                        </Button.Content>
                    </Button>
                    
                    <Grid>
                        <Button x:Name="BtnAndOr" Tag="[|]" Margin="{StaticResource LeftButtonMargin}" Click="ReShortcutButton_Click">
                            <Button.Content>
                                <TextBlock>
                                Or
                                <Run Style="{StaticResource BracketTextStyle}"> [|]</Run>
                                </TextBlock>
                            </Button.Content>
                        </Button>

                        <!-- Popup floating next to the OR button -->
                        <Popup x:Name="OrPopup"
                               PlacementTarget="{Binding ElementName=BtnAndOr}"
                               Placement="Left"
                               StaysOpen="True"
                               HorizontalOffset="-20"
                               VerticalOffset="-50"
							   AllowsTransparency="True"
                               PopupAnimation="Scroll"
							   Opened="OrPopup_Opened">
                            <Border Background="White" 
                                    BorderBrush="Gray" 
                                    BorderThickness="1" 
                                    CornerRadius="5" 
                                    Width="200"
                                    Padding="10" >
                                <StackPanel>
                                    <DockPanel HorizontalAlignment="Right">
                                        <Button x:Name="AndOrToggle" 
                                                Content="Mode: OR" 
                                                Margin="0,0,5,0"
                                                Padding="5,0"
                                                Background="Transparent"
                                                BorderBrush="Gray"
                                                Click="AndOrToggle_Click"/>
                                        <Button x:Name="PopBtnClose" Content="X" Width="20" Height="20" Padding="0" Click="PopBtnClose_Click" BorderBrush="#FF9C2323" Foreground="#FF9C2323" Background="White"/>
                                    </DockPanel>
                                    <!-- Where we dynamically add textboxes -->
                                    <StackPanel x:Name="ConditionPanel" Margin="{StaticResource StandardMargin}"/>
                                    <!-- Add / Remove and Okay buttons -->
                                    <UniformGrid Columns="2" HorizontalAlignment="Stretch" Margin="{StaticResource StandardMargin}">
                                        <Button x:Name="PopBtnAddBox" Content="Add" Margin="0,0,5,0" Click="PopBtnAddBox_Click"/>
                                        <Button x:Name="PopBtnRmvBox" Content="Remove" Margin="5,0,0,0" IsEnabled="False" Click="PopBtnRmvBox_Click"/>
                                    </UniformGrid>
                                    <Button x:Name="PopBtnOk" Content="Apply Changes" HorizontalAlignment="Stretch" Margin="{StaticResource StandardMargin}" Click="PopBtnOk_Click"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>

                    <Button x:Name="BtnGroup" Tag="(...)" Margin="{StaticResource RightButtonMargin}" Click="ReShortcutButton_Click">
                        <Button.Content>
                            <TextBlock>
                                Group
                                <Run Style="{StaticResource BracketTextStyle}"> [(...)]</Run>
                            </TextBlock>
                        </Button.Content>
                    </Button>
                </UniformGrid>
            </Expander>

            <!-- Checkboxes -->
            <Grid Margin="{StaticResource StandardMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="MatchCaseCheckBox" Content="Match Case"/>
                <CheckBox x:Name="AnnotationTagsCheckBox" Grid.Column="2" Content="Inc. Annotation Tags"/>
            </Grid>

            <!-- Search Button -->
            <Button x:Name="SearchButton" Content="Search" Width="95" HorizontalAlignment="Stretch" Margin="{StaticResource StandardMargin}" Click="SearchButton_Click"/>
        </StackPanel>
    </Grid>
</Window>


<!-- Explain how user can use groups () -->
<!-- Standardise all Button tooltips to have overview and examples in headers with fix window and all code in bold -->
 