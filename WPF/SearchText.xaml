<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Search Text"
        Width="400"
        MinWidth="400"
        MaxWidth="400"
        SizeToContent="Height"
        MinHeight="200">
    <Grid Margin="10">
        <StackPanel>
            <Label x:Name="EnterTextLabel" Content="Enter Text:" HorizontalAlignment="Left"/>
            <TextBox x:Name="InputTextBox"
                     MinWidth="120"
                     MaxWidth="400"
                     HorizontalAlignment="Stretch"
                     TextWrapping="Wrap"
                     VerticalAlignment="Top"
                     AcceptsReturn="True"
                     Height="Auto"/>
            <StackPanel x:Name="MatchPanel" Orientation="Horizontal" Margin="0,10,0,10">
                <Label x:Name="MatchLabel" Content="Match" HorizontalAlignment="Left"/>
                <ComboBox x:Name="MatchComboBox" Width="120" Margin="0,0,0,0"/>
            </StackPanel>
            <CheckBox x:Name="RegexCheckBox" Content="Inlcude ReGeX" IsChecked="True" Margin="0,2,0,2"/>
            <CheckBox x:Name="MatchCaseCheckBox" Content="Match Case" Margin="0,2,0,2"/>
            <CheckBox x:Name="AnnotationTagsCheckBox" Content="Inlcude Annotation tags" Margin="0,2,0,2"/>
            <Button x:Name="SearchButton" Content="Search" Width="75" HorizontalAlignment="Center" Margin="0,20,0,0" Click="SearchButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
