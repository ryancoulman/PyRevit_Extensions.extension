<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="av"
        Title="Element Viewer" Height="330" Width="400" HorizontalAlignment="Center" Background="White" Foreground="Black">
    <StackPanel Margin="10">
        <TextBlock x:Name="display_tb" Text="Selected Items" FontSize="14" Margin="0,0,0,10" HorizontalAlignment="Center"/>
        <ListBox x:Name="elements_lb" Height="200"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
            <Button x:Name="prev_b" Content="Prev" Width="75" Margin="5"/>
            <Button x:Name="next_b" Content="Next" Width="75" Margin="5"/>
            <Button x:Name="show_b" Content="Show" Width="75" Margin="5"/>
        </StackPanel>
    </StackPanel>
</Window>
