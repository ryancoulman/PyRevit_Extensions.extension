<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Element Viewer" Height="150" Width="400">
    <StackPanel Margin="10">
        <TextBlock x:Name="display_tb" Text="..." FontSize="14" Margin="0,0,0,10"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="prev_b" Content="Prev" Width="75" Margin="5"/>
            <Button x:Name="next_b" Content="Next" Width="75" Margin="5"/>
            <Button x:Name="close_b" Content="Close" Width="75" Margin="5"/>
        </StackPanel>
    </StackPanel>
</Window>
